# Build outputs
.gradle/
.kotlin/
build/
app/.cxx/
.cxx/
app/release/
captures/
*.apk
*.aab
*.dm

# IDE files (the project icon is kept on purpose)
.idea/*
!.idea/icon.svg
*.iml

# Local tooling scratch space
.tmp/
.zcode/
.workbuddy/

# Local configuration and signing material
local.properties
keystore.properties
*.jks
*.keystore

# Local only: release upload token / gh credentials, never commit
.release-token
.github-token

# Project documentation beyond README (kept locally, not part of the repository)
CHANGELOG.md
CONTRIBUTING.md
CODE_OF_CONDUCT.md

# Internal design notes, research and handover documents (kept locally only)
docs/

# Logs, dumps and crash reports
*.log
*.hprof
*.stackdump

# Python tooling
__pycache__/
*.py[cod]

# OS junk
.DS_Store
Thumbs.db

# Patch leftovers
*.orig
*.rej
